#!/bin/bash
# The sea belongs to the theme it arrived with.
#
# Omarchy runs every script in `theme-set.d` after a theme change, with the new
# theme's slug in $1. Nothing else would ever stop the water: the native
# renderer is a service of the session rather than something the theme owns, so
# without this it goes on drawing over whatever theme comes next, recoloured to
# it and still unmistakably a sea. A desk that switched away from this theme is
# entitled to the wallpaper the one it switched to came with.
#
# The QML renderer needs nothing here. It is the background plugin, so it draws
# whatever picture the current theme names, and it puts the sea away by itself
# when the theme is not this one.
#
# `start` on a service already running is a no-op, so cycling backgrounds inside
# this theme does not reload the water.

set -euo pipefail

MINE="@THEME@"
THEME="${1:-$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)}"

# Only the native renderer is a unit, and only an enabled one is ours to start.
# Installing the QML renderer disables this service rather than deleting it, so
# the file alone is not the question: a desk that chose the other water would
# otherwise get both of them the moment it came back to this theme.
systemctl --user is-enabled seascape.service >/dev/null 2>&1 || exit 0

if [[ $THEME == "$MINE" ]]; then
  systemctl --user start seascape.service
else
  systemctl --user stop seascape.service
fi
